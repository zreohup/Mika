<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 探针页把记录广播给 Mika 进程里的测试 -->
    <queries>
        <package android:name="com.wangzan101.mika" />
        <!-- 重现「开到用户主屏上」的页面要拿别的 App 的启动入口 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application>
        <!-- 测试用页面,由测试用 am start 打开到虚拟屏。它们运行在测试包自己的进程里、不带 Kotlin 标准库,
             所以用 Java 写;类名必须和源文件里的一致(AndroidTestManifestTest 会查) -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.SecureTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.PlainTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.a11y.WebEditorTestActivity" android:exported="true" />
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.FieldsTestActivity" android:exported="true" />
        <!-- 滚轮测试页:两个原版数字滚轮 -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.WheelPickerTestActivity" android:exported="true" />
        <!-- 从应用上下文打开别的 App:重现「开到用户主屏上」 -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.SpillTestActivity" android:exported="true" />
        <!-- 对话框样式的页面:重现登录验证一类要用户在主屏点确认的弹窗 -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.DialogSpillTestActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Dialog" />
        <!-- 整屏的账号登录页:形状和普通 App 页面一样,只有「所在的包是没有桌面图标的账号认证器」能认出它 -->
        <activity android:name="com.wangzan101.mika.cap.phone.a11y.FullScreenAuthTestActivity" android:exported="true" />
        <!-- 测试包的账号认证器:默认关着,只在 AuthSpillDeviceTest 里打开、测完关掉,别的挪回测试不受它影响。
             测试包没有 LAUNCHER 入口,打开后它就是一个没有桌面图标的账号认证器包 -->
        <service android:name="com.wangzan101.mika.cap.phone.a11y.TestAuthenticatorService" android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/test_authenticator" />
        </service>
        <service android:name="com.wangzan101.mika.cap.phone.a11y.SpillLaunchService" android:process=":spill" android:exported="false" />
        <!-- 外壳对照测试的探针页:startApp 走启动入口(INFO,不进桌面),startView 走自定义链接 -->
        <activity android:name="com.wangzan101.mika.shell.ShellProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mika-parity" />
            </intent-filter>
        </activity>
        <!-- 一直在出声(循环播放无声的声音)的探针页:任务结束时正在出声的 App 默认关掉 -->
        <activity android:name="com.wangzan101.mika.shell.AudioProbeActivity" android:exported="true" />
    </application>
</manifest>
