    <string name="appaccess_send_title">Kirim daftar aplikasi ke AI?</string>
    <string name="appaccess_send_body">Penyegaran akan membaca aplikasi yang terpasang dan mengirim nama serta nama paketnya ke model AI yang Anda atur, untuk menentukan kategori risiko. Isi di dalam aplikasi tidak dikirim.</string>
    <string name="appaccess_send_confirm">Lanjutkan dan kategorikan</string>
    <string name="appaccess_cancel">Batal</string>

    <string name="appaccess_recommend_title">Disarankan diblokir: aplikasi keuangan</string>
    <string name="appaccess_recommend_body">Aplikasi ini tergolong keuangan atau pembayaran, dan Mika masih bisa mengoperasikannya. Blokir satu per satu, atau sekaligus.</string>
