    <string name="appaccess_category_manual">手動で設定</string>

    <string name="appaccess_error_save">保存できませんでした</string>
    <string name="appaccess_error_no_model">使えるモデルがありません。アプリ一覧は更新されましたが、分類できません。</string>
    <string name="appaccess_error_refresh">更新に失敗しました</string>
    <string name="appaccess_error_load">アプリ一覧を読み取れませんでした</string>

