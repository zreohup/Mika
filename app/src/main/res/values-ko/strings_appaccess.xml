    <string name="appaccess_category_unknown">미분류</string>

    <string name="appaccess_share_title">%1$s 화면 공유</string>
    <string name="appaccess_share_body">이 앱은 차단되어 있어요. 화면 공유를 사용하면 직접 골라서 공유할 수 있고, 자동 읽기와 조작은 계속 차단돼요.</string>
    <string name="appaccess_share_allow">화면 공유만 허용</string>
    <string name="appaccess_share_unblock">차단 해제</string>
    <string name="appaccess_share_cancel">공유 취소</string>
    <string name="appaccess_share_expired">화면 공유 권한이 만료됐어요. 스크린샷을 다시 찍으세요.</string>
