# Edit the domain and certificate paths before installing in nginx's http context.
map $http_upgrade $mika_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;
    server_name mika.example.com;
    access_log off;
    return 308 https://mika.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name mika.example.com;
    ssl_certificate /etc/ssl/mika/fullchain.pem;
    ssl_certificate_key /etc/ssl/mika/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:18787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The relay rate-limits each caller by this address; replace, never append, client-supplied values.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mika_connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_next_upstream off;
    }
}
